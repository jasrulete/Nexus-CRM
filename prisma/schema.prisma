// Prisma schema for Nexus CRM
// SQLite does not support enums — enum-like fields are strings validated
// with zod at the application boundary (see src/lib/validation.ts).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         String    @default("MEMBER") // ADMIN | MEMBER
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions   Session[]
  companies  Company[]
  contacts   Contact[]
  deals      Deal[]
  activities Activity[]
  tasks      Task[]
  auditLogs  AuditLog[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique // sha256 of the cookie token — raw token never stored
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?

  @@index([userId])
}

model Company {
  id        String   @id @default(cuid())
  name      String
  domain    String?
  industry  String?
  size      String? // 1-10 | 11-50 | 51-200 | 201-1000 | 1000+
  website   String?
  notes     String?
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts   Contact[]
  deals      Deal[]
  activities Activity[]

  @@index([ownerId])
}

model Contact {
  id        String  @id @default(cuid())
  firstName String
  lastName  String
  email     String?
  phone     String?
  title     String?
  status    String  @default("LEAD") // LEAD | QUALIFIED | CUSTOMER | CHURNED
  source    String? // referral | website | outbound | event | other
  notes     String?

  // AI lead scoring
  aiScore       Int?
  aiScoreReason String?
  aiScoredAt    DateTime?

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deals      Deal[]
  activities Activity[]
  tasks      Task[]

  @@index([ownerId])
  @@index([companyId])
  @@index([status])
}

model Deal {
  id       String @id @default(cuid())
  title    String
  value    Int    @default(0) // whole currency units
  currency String @default("USD")
  stage    String @default("LEAD") // LEAD | QUALIFIED | PROPOSAL | NEGOTIATION | WON | LOST
  position Int    @default(0) // ordering within a stage column

  expectedCloseDate DateTime?
  closedAt          DateTime?

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities Activity[]
  tasks      Task[]

  @@index([ownerId])
  @@index([stage])
  @@index([contactId])
  @@index([companyId])
}

model Activity {
  id      String @id @default(cuid())
  type    String // NOTE | CALL | EMAIL | MEETING
  content String

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  dealId    String?
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([contactId])
  @@index([dealId])
  @@index([companyId])
}

model Task {
  id      String    @id @default(cuid())
  title   String
  done    Boolean   @default(false)
  dueDate DateTime?

  contactId  String?
  contact    Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  dealId     String?
  deal       Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  assigneeId String
  assignee   User     @relation(fields: [assigneeId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([assigneeId, done])
  @@index([contactId])
  @@index([dealId])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String // e.g. contact.create, deal.stage_change, auth.login
  entityType String
  entityId   String
  metadata   String? // JSON details of the change
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}
